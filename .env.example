# Read README before configuring. Never commit a real token.
DATABASE_URL=postgres://localhost/rails8_face_recognition_development
MODAL_EMBEDDINGS_API_URL=https://your-allowlisted-gateway.example.com
EMBEDDINGS_API_BEARER_TOKEN=
# Bootstrap an admin ONCE using bin/rails db:seed (password will not be logged)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Production R2 - optional for development, required for private production storage.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REFERENCE_BUCKET=compactfaces-reference
R2_SUBMISSIONS_BUCKET=compactfaces-submissions
# Optional HTTPS hostname allowlist (required before enabling live inference)
INFERENCE_ALLOWED_HOSTS=your-allowlisted-gateway.example.com
# Production Rails encryption key, generated locally; do not commit
SECRET_KEY_BASE=

# Operator-staged snapshot directory containing metadata.csv and PNG files (never supplied by member requests)
DATASET_IMPORT_ROOT=

# Account registration: enabled by default, but registration fails closed without
# an email transport. In development EMAIL_PROVIDER=file writes to tmp/mails.
PUBLIC_REGISTRATION_ENABLED=true
APP_HOST=localhost
APP_PROTOCOL=http
# Transactional mail via SMTP. Choose: resend | brevo | postmark | sendpulse | smtp | file
# Production MUST configure a live provider and verified sender. Do not commit keys.
EMAIL_PROVIDER=file
EMAIL_FROM=Rails 8 Face Recognition <no-reply@example.com>
EMAIL_HELO_DOMAIN=example.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
# Resend: host smtp.resend.com, user resend, password Resend API key.
# Brevo: host smtp-relay.brevo.com, user SMTP login, password SMTP key (NOT API key).
# Postmark: host smtp.postmarkapp.com, server token as both fields OR SMTP key pair.
# SendPulse: copy host/login/password directly from SMTP Dashboard (may vary by account).
# All SMTP providers use STARTTLS on port 587. With port 465, implicit SSL is enabled.
