<% content_for :title, "#{t('auth.register')} · Rails 8 Face Recognition" %>
<div class="mx-auto max-w-xl panel p-7 sm:p-10">
  <p class="section-kicker"><%= t('auth.member_access') %></p>
  <h1 class="page-title"><%= t('auth.register') %></h1>
  <p class="page-description"><%= t('auth.register_intro') %></p>
  <% if registration_available? %>
    <%= render 'shared/form_errors', record: @user %>
    <%= form_with model: @user, url: registration_path, class: 'mt-7 space-y-5' do |f| %>
      <div><%= f.label :email, t('auth.email'), class: 'field-label' %><%= f.email_field :email, class: 'field', required: true, autocomplete: 'email', maxlength: 254 %></div>
      <div><%= f.label :password, t('auth.password'), class: 'field-label' %><%= f.password_field :password, class: 'field', required: true, autocomplete: 'new-password', minlength: 12 %><p class="field-hint"><%= t('auth.password_hint') %></p></div>
      <div><%= f.label :password_confirmation, t('auth.password_confirmation'), class: 'field-label' %><%= f.password_field :password_confirmation, class: 'field', required: true, autocomplete: 'new-password', minlength: 12 %></div>
      <label class="flex items-start gap-3 text-sm leading-6"><%= check_box_tag :accept_terms, '1', false, required: true, class: 'mt-1' %><span><%= t('auth.privacy_consent') %> <%= link_to t('nav.privacy'), privacy_path, class: 'text-link' %> · <%= link_to t('nav.terms'), terms_path, class: 'text-link' %></span></label>
      <%= f.submit t('auth.register_submit'), class: 'btn-primary w-full', data: { turbo_submits_with: t('common.processing') } %>
    <% end %>
  <% else %>
    <div class="alert-warning mt-6"><%= t('auth.registration_disabled') %></div>
  <% end %>
  <p class="mt-6 text-sm"><%= link_to t('auth.already_have_account'), sign_in_path, class: 'text-link' %></p>
</div>
