<div class="panel mt-8 max-w-3xl p-7"><%= render "shared/form_errors", record: service %><%= form_with model: [:admin, service], class: "mt-5 space-y-5" do |f| %>
  <div><%= f.label :name, class: "field-label" %><%= f.text_field :name, required: true, class: "field", placeholder: "modal-embeddings" %></div>
  <div><%= f.label :base_url, ui("HTTPS gateway base URL"), class: "field-label" %><%= f.url_field :base_url, required: true, class: "field", placeholder: "https://your-service.modal.run" %><p class="field-hint"><%= ui('Host-only URL. Runtime checks require INFERENCE_ALLOWED_HOSTS; private addresses and redirects are rejected.') %></p></div>
  <div><%= f.label :auth_secret_reference, ui("Environment variable name"), class: "field-label" %><%= f.text_field :auth_secret_reference, required: true, class: "field", placeholder: "EMBEDDINGS_API_BEARER_TOKEN" %><p class="field-hint"><%= ui('Enter only the ENV variable name, never the actual token.') %></p></div>
  <div><%= f.label :request_timeout_seconds, ui("Inference request timeout (seconds)"), class: "field-label" %><%= f.number_field :request_timeout_seconds, min: 30, max: 600, required: true, class: "field" %></div>
  <label class="flex items-center gap-3 rounded-xl border border-white/10 p-4 text-sm"><%= f.check_box :enabled, class: "h-4 w-4 accent-cyan-300" %><span><%= ui('Enable this service for inference calls') %></span></label>
  <div class="flex gap-3"><%= f.submit ui("Save service"), class: "btn-primary" %><%= link_to ui("Cancel"), admin_inference_services_path, class: "btn-secondary" %></div>
<% end %></div>
