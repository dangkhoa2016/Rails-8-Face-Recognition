<% content_for :title, "#{t('nav.services')} · Rails 8 Face Recognition" %>
<%= render "shared/page_header", eyebrow: ui("Administration / Infrastructure"), title: ui("Inference services"), description: ui("Allowlisted HTTPS endpoints and secret references. Raw bearer tokens are never stored in these records or displayed in the browser."), action_text: ui("+ Add service"), action_path: new_admin_inference_service_path %>
<% if @services.empty? %><div class="mt-8"><%= render "shared/empty", title: ui("No inference services"), description: ui("Add a public HTTPS service and configure a server-side token. Explicitly allowlist its hostname before connectivity checks."), action_text: ui("Add service"), action_path: new_admin_inference_service_path %></div><% else %>
<div class="mt-8 grid gap-5 xl:grid-cols-2"><% @services.each do |service| %><article class="panel p-7"><div class="flex flex-wrap items-center justify-between gap-3"><h2 class="text-xl font-semibold"><%= service.name %></h2><%= status_badge(service.enabled? ? "ready" : "disabled") %></div><p class="mt-4 break-all font-mono text-xs text-cyan-300"><%= service.base_url %></p><div class="mt-5 grid grid-cols-2 gap-5 border-t border-white/10 pt-5"><div><p class="detail-label"><%= ui('Secret availability') %></p><p class="detail-value"><%= service.secret_available? ? ui("Configured on server") : ui("Not configured") %></p></div><div><p class="detail-label"><%= ui('Timeout') %></p><p class="detail-value"><%= service.request_timeout_seconds %> s</p></div><div><p class="detail-label"><%= ui('Registered models') %></p><p class="detail-value"><%= service.embedding_models.size %></p></div><div><p class="detail-label"><%= ui('Token ref') %></p><p class="detail-value font-mono text-xs"><%= service.auth_secret_reference %></p></div></div><div class="mt-6 flex flex-wrap gap-3"><%= link_to ui("Edit configuration"), edit_admin_inference_service_path(service), class: "btn-secondary" %><%= button_to ui("Check gateway"), check_connection_admin_inference_service_path(service), method: :post, class: "btn-primary", form: { data: { turbo_confirm: ui("Send an authenticated GET /v1/models request to this allowlisted gateway?") } } %></div></article><% end %></div><% end %>
