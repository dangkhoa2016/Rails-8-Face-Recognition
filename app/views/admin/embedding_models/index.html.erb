<% content_for :title, "#{t('nav.models')} · Rails 8 Face Recognition" %>
<%= render "shared/page_header", eyebrow: ui("Administration / Models"), title: ui("Embedding models"), description: ui("The model ID sent to Modal is a stable API string, not an internal numeric database ID. Dimensions are validated against each model's declared capabilities."), action_text: ui("+ Add model"), action_path: new_admin_embedding_model_path %>
<% if @models.empty? %><div class="mt-8"><%= render "shared/empty", title: ui("No embedding models"), description: ui("Register an inference service and verify its model IDs and supported dimensions."), action_text: ui("Register model"), action_path: new_admin_embedding_model_path %></div><% else %><div class="mt-8 grid gap-5 xl:grid-cols-2"><% @models.each do |model| %><div class="panel p-7"><div class="flex justify-between gap-3"><h2 class="text-xl font-semibold"><%= model.display_name %></h2><%= status_badge(model.enabled? ? "ready" : "disabled") %></div><p class="mt-3 font-mono text-xs text-cyan-300"><%= model.api_model_id %></p><p class="mt-3 text-sm text-slate-400"><%= model.repository_name %></p><div class="mt-5 border-t border-white/10 pt-5"><p class="detail-label"><%= ui('Supported dimensions') %></p><p class="detail-value font-mono text-xs"><%= model.supported_dimensions.to_json %></p><p class="mt-4 detail-label"><%= ui('Gateway') %></p><p class="detail-value"><%= model.inference_service.name %></p></div><%= link_to ui("Edit model settings →"), edit_admin_embedding_model_path(model), class: "btn-secondary mt-5" %></div><% end %></div><% end %>
