<% content_for :title, "#{t('nav.identities')} · Rails 8 Face Recognition" %>
<%= render "shared/page_header", eyebrow: ui("Administration / Dataset"), title: ui("Core identities"), description: ui("Only the 120 Core dataset identities belong in this directory. Additional identities must never be inserted as enrollment identities.") %>
<%= form_with url: admin_identities_path, method: :get, class: "panel mt-8 flex flex-wrap items-end gap-3 p-5" do |f| %><div class="min-w-64 flex-1"><%= f.label :q, ui("Search identity key or name"), class: "field-label" %><%= f.search_field :q, value: @query, placeholder: "CORE:...", class: "field" %></div><%= f.submit ui("Search"), class: "btn-primary" %><%= link_to ui("Clear"), admin_identities_path, class: "btn-quiet" %><% end %>
<% if @total.zero? %><div class="mt-6"><%= render "shared/empty", title: ui("No Core identities found"), description: ui("First verify and import the CompactFaces dataset; identity creation is deliberately not available from this page."), action_text: ui("Dataset imports"), action_path: admin_dataset_imports_path %></div><% else %><div class="table-wrap mt-6"><table class="data-table"><thead><tr><th><%= ui('Identity') %></th><th><%= ui('Reference images') %></th><th><%= ui('Active') %></th><th><%= ui('Created') %></th><th><%= ui('Details') %></th></tr></thead><tbody><% @identities.each do |identity| %><tr><td class="font-semibold text-white"><%= identity.display_name %><div class="mt-1 font-mono text-xs text-slate-500"><%= identity.external_identity_key %></div></td><td><%= identity.face_images.count %> / 5</td><td><%= status_badge(identity.active? ? "ready" : "disabled") %></td><td><%= short_time(identity.created_at) %></td><td><%= link_to ui("View →"), admin_identity_path(identity), class: "text-link" %></td></tr><% end %></tbody></table></div><%= render "shared/pager", total: @total, page: @page, per_page: 25 %><% end %>
