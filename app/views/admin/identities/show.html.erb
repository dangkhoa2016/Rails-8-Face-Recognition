<% content_for :title, "#{@identity.display_name} · Rails 8 Face Recognition" %>
<%= link_to "← Core identities", admin_identities_path, class: "text-link text-sm" %>
<div class="mt-5 flex flex-wrap items-start justify-between gap-4"><div><p class="section-kicker"><%= ui('Administration / Identity') %></p><h1 class="page-title"><%= @identity.display_name %></h1><p class="page-description font-mono"><%= @identity.external_identity_key %></p></div><%= status_badge(@identity.active? ? "ready" : "disabled") %></div>
<div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
  <section class="panel p-6"><h2 class="text-lg font-semibold"><%= ui('Dataset images') %></h2><p class="mt-2 text-sm text-slate-500"><%= ui('Only SOURCE is an enrollment reference. Other slots remain probes.') %></p><div class="mt-5 grid gap-4 sm:grid-cols-2"><% @images.each do |img| %><%= link_to admin_face_image_path(img), class: "overflow-hidden rounded-xl border border-white/10 hover:border-cyan-400/40" do %><div class="aspect-[4/3] bg-slate-800"><% if img.image.attached? %><%= image_tag face_image_path(img), alt: "#{@identity.display_name} #{img.slot}", class: "h-full w-full object-cover" %><% else %><div class="grid h-full place-items-center text-slate-500"><%= ui('No image') %></div><% end %></div><div class="flex justify-between gap-2 p-3 text-sm"><span><%= img.slot %></span><%= status_badge(img.role) %></div><% end %><% end %></div></section>
  <div class="space-y-5"><div class="panel p-6"><h2 class="font-semibold"><%= ui('Enrollment status') %></h2><p class="mt-3 text-sm leading-6 text-slate-400"><%= ui('Disabling an identity removes it from new recognition queries, but does not delete its reference images or cached vectors.') %></p><%= button_to @identity.active? ? ui("Disable identity") : ui("Enable identity"), admin_identity_path(@identity, active: @identity.active? ? "false" : "true"), method: :patch, class: "#{@identity.active? ? 'btn-danger' : 'btn-primary'} mt-5 w-full", form: { data: { turbo_confirm: ui("Change this identity's active status? This will affect gallery coverage.") } } %></div><div class="panel p-6"><p class="detail-label"><%= ui('Images stored') %></p><p class="mt-3 text-3xl font-semibold"><%= @images.size %><span class="text-base text-slate-500"> / 5</span></p></div></div>
</div>
