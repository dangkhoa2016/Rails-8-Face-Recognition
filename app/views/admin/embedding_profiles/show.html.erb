<% content_for :title, "Embedding Profile ##{@profile.id} · Rails 8 Face Recognition" %>
<%= link_to "← Embedding profiles", admin_embedding_profiles_path, class: "text-link text-sm" %>
<div class="mt-5 flex flex-wrap items-start justify-between gap-5"><div><p class="section-kicker"><%= ui('Administration / Embedding profile #') %><%= @profile.id %></p><h1 class="page-title"><%= @profile.embedding_model.display_name %> · <span class="text-cyan-300"><%= @profile.dimension %>D</span></h1><p class="page-description"><%= ui('Exact pinned configuration. Existing vectors are always stored under this profile and cannot be rewritten in place.') %></p></div><div class="flex items-center gap-2"><%= status_badge(@profile.status) %><% if @active %><span class="badge badge-success"><%= ui('Active') %></span><% end %></div></div>
<div class="mt-8 grid gap-4 sm:grid-cols-3"><%= card_metric @profile.available_enrollments, ui("Completed enrollments"), "Of #{@profile.required_enrollments} active SOURCE images" %><%= card_metric @profile.missing_enrollment_images.count, ui("Missing vectors"), ui("Eligible for Generate Missing") %><%= card_metric @requests.fetch("failed", 0), ui("Failed requests"), "#{@requests.fetch('processing', 0)} processing · #{@requests.fetch('pending', 0)} queued" %></div>
<div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(360px,.85fr)]">
  <section class="panel space-y-6 p-7"><h2 class="text-xl font-semibold"><%= ui('Pinned configuration') %></h2><div class="grid gap-5 sm:grid-cols-2"><div><p class="detail-label"><%= ui('Model API ID') %></p><p class="detail-value font-mono text-xs"><%= @profile.embedding_model.api_model_id %></p></div><div><p class="detail-label"><%= ui('Dimension') %></p><p class="detail-value"><%= @profile.dimension %></p></div><div class="sm:col-span-2"><p class="detail-label"><%= ui('Checkpoint revision') %></p><p class="detail-value break-all font-mono text-xs"><%= @profile.model_revision %></p></div><div><p class="detail-label"><%= ui('Preprocessing') %></p><p class="detail-value"><%= @profile.preprocessing_version %></p></div><div><p class="detail-label"><%= ui('Instruction') %></p><p class="detail-value"><%= @profile.instruction.presence || ui("Model default") %></p></div><div class="sm:col-span-2"><p class="detail-label"><%= ui('Confirmed config SHA-256') %></p><p class="detail-value break-all font-mono text-xs"><%= @profile.config_sha256.presence || ui("Awaiting preflight") %></p></div><div class="sm:col-span-2"><p class="detail-label"><%= ui('Rails request digest') %></p><p class="detail-value break-all font-mono text-xs"><%= @profile.request_config_digest %></p></div></div></section>
  <div class="space-y-6"><section class="panel p-7"><h2 class="text-xl font-semibold"><%= ui('Operations') %></h2><p class="mt-3 text-sm leading-7 text-slate-400"><%= ui('Preflight uses a single authorized Core SOURCE reference to pin the server configuration. Generate Missing queues only unencoded SOURCE records for this exact profile.') %></p>
    <div class="mt-5 flex flex-wrap gap-3"><% if @profile.status.in?(%w[draft error]) && @profile.config_sha256.blank? %><%= button_to ui("Run preflight"), preflight_admin_embedding_profile_path(@profile), method: :post, class: "btn-primary", form: { data: { turbo_confirm: ui("Call the configured Modal service with one Core SOURCE image to verify pinned metadata?") } } %><% end %>
      <% if @profile.status.in?(%w[preparing ready]) && @profile.config_sha256.present? %><%= button_to ui("Generate missing"), generate_missing_admin_embedding_profile_path(@profile), method: :post, class: "btn-secondary", form: { data: { turbo_confirm: ui("Queue only missing SOURCE embedding requests for this profile? Inference may incur GPU cost.") } } %><% end %>
      <% if @profile.coverage_complete? && @policy && !@active %><%= button_to ui("Activate profile"), activate_admin_embedding_profile_path(@profile), method: :post, class: "btn-primary", form: { data: { turbo_confirm: ui("Activate this fully enrolled profile with its approved threshold?") } } %><% end %>
      <% if @active %><%= button_to ui("Deactivate recognition"), admin_deactivate_embedding_profile_path, method: :post, class: "btn-danger", form: { data: { turbo_confirm: ui("Disable new recognition requests? Existing vectors remain stored.") } } %><% end %></div>
    <% unless @profile.coverage_complete? %><div class="alert-warning mt-5"><%= ui('Not activation-ready. All 120 active Core SOURCE vectors, ready status and a matching approved policy are required.') %></div><% end %>
  </section>
  <section class="panel p-7"><h2 class="text-xl font-semibold"><%= ui('Recognition policy') %></h2><% if @policy %><p class="mt-4"><%= status_badge @policy.status %></p><p class="mt-3 text-sm text-slate-300"><%= ui('Threshold:') %> <strong><%= number_with_precision(@policy.threshold, precision: 5) %></strong></p><%= link_to ui("Inspect approved policy →"), admin_recognition_policy_path(@policy), class: "text-link mt-4 inline-block text-sm" %><% else %><p class="mt-3 text-sm leading-6 text-slate-400"><%= ui('No approved evaluation report is attached. A profile cannot be activated until independent calibration has been reviewed.') %></p><%= link_to ui("Register policy →"), new_admin_recognition_policy_path, class: "text-link mt-4 inline-block text-sm" %><% end %></section></div>
</div>
