<% content_for :title, "#{t('nav.profiles')} · Rails 8 Face Recognition" %>
<%= render "shared/page_header", eyebrow: ui("Administration / Vector configuration"), title: ui("Embedding profiles"), description: ui("A profile is an immutable model + dimension + checkpoint revision + preprocessing + instruction configuration. Switching back reuses its stored embeddings."), action_text: ui("+ Create profile"), action_path: new_admin_embedding_profile_path %>
<div class="alert-info mt-7"><%= ui('Changing from 1024D → 4096D → 1024D never deletes the original 1024D cache. When already complete, activating the old profile requires no extra enrollment inference calls.') %></div>
<% if @profiles.empty? %><div class="mt-7"><%= render "shared/empty", title: ui("No profiles have been defined"), description: ui("Enable a verified model and create a pinned embedding profile to begin preparing Core SOURCE vectors."), action_text: ui("Create profile"), action_path: new_admin_embedding_profile_path %></div><% else %>
<div class="table-wrap mt-7"><table class="data-table"><thead><tr><th><%= ui('Model') %></th><th><%= ui('Dimension') %></th><th><%= ui('Revision') %></th><th><%= ui('Coverage') %></th><th><%= ui('Status') %></th><th><%= ui('Profile') %></th></tr></thead><tbody><% @profiles.each do |profile| %><tr><td><p class="font-semibold text-white"><%= profile.embedding_model.display_name %></p><p class="mt-1 font-mono text-xs text-slate-500"><%= profile.embedding_model.api_model_id %></p></td><td class="text-xl font-semibold text-cyan-200"><%= profile.dimension %>D</td><td class="font-mono text-xs"><%= short_sha(profile.model_revision) %></td><td><p><%= profile.available_enrollments %> / <%= profile.required_enrollments %></p><progress class="mt-2 block h-2 w-28 accent-cyan-300" value="<%= profile.available_enrollments %>" max="<%= [profile.required_enrollments, 1].max %>" aria-label="<%= ui('Enrollment coverage') %>"></progress></td><td><%= status_badge(profile.status) %><% if @active_profile_id == profile.id %><p class="mt-2 text-xs font-semibold text-emerald-300"><%= ui('Currently active') %></p><% end %></td><td><%= link_to ui("Open →"), admin_embedding_profile_path(profile), class: "text-link" %></td></tr><% end %></tbody></table></div><% end %>
