<% content_for :title, "#{t('nav.policies')} · Rails 8 Face Recognition" %>
<%= render "shared/page_header", eyebrow: ui("Administration / Decisions"), title: ui("Recognition policies"), description: ui("Thresholds and margins come from independent evaluation evidence. Rails never runs a threshold sweep or substitutes a guessed cutoff."), action_text: ui("+ Register policy"), action_path: new_admin_recognition_policy_path %>
<% if @policies.empty? %><div class="mt-8"><%= render "shared/empty", title: ui("No recognition policies"), description: ui("Import a verified external evaluation report and register its decision threshold for the exact embedding profile."), action_text: ui("Register policy"), action_path: new_admin_recognition_policy_path %></div><% else %><div class="table-wrap mt-8"><table class="data-table"><thead><tr><th><%= ui('Profile') %></th><th><%= ui('Threshold') %></th><th><%= ui('Margin') %></th><th><%= ui('Status') %></th><th><%= ui('Evidence') %></th><th><%= ui('Details') %></th></tr></thead><tbody><% @policies.each do |policy| %><tr><td class="font-semibold text-white"><%= policy.embedding_profile.embedding_model.display_name %> · <%= policy.embedding_profile.dimension %>D</td><td><%= policy.threshold.nil? ? ui("Not set") : number_with_precision(policy.threshold, precision: 5) %></td><td><%= policy.decision_margin.nil? ? "—" : number_with_precision(policy.decision_margin, precision: 5) %></td><td><%= status_badge(policy.status) %></td><td class="font-mono text-xs"><%= short_sha(policy.evaluation_report_sha256) %></td><td><%= link_to ui("Review →"), admin_recognition_policy_path(policy), class: "text-link" %></td></tr><% end %></tbody></table></div><% end %>
