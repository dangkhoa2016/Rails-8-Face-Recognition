<% content_for :title, "#{t('recognition_policy_form.document_title')} · Rails 8 Face Recognition" %>
<%= link_to "← #{t('recognition_policy_form.back')}", admin_recognition_policies_path, class: "text-link text-sm" %>
<%= render "shared/page_header",
  eyebrow: t("recognition_policy_form.eyebrow"),
  title: t("recognition_policy_form.title"),
  description: t("recognition_policy_form.introduction") %>

<section class="panel mt-8 p-6 sm:p-7" data-testid="recognition-policy-guide" aria-labelledby="recognition-policy-guide-title">
  <h2 id="recognition-policy-guide-title" class="text-xl font-semibold"><%= t("recognition_policy_form.guide_title") %></h2>
  <p class="mt-2 text-sm leading-7 text-slate-400"><%= t("recognition_policy_form.guide_intro") %></p>
  <ol class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <% (1..4).each do |step| %>
      <li class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
        <span class="text-xs font-bold tracking-wider text-cyan-300" aria-hidden="true"><%= format("%02d", step) %></span>
        <h3 class="mt-2 text-sm font-semibold text-slate-100"><%= t("recognition_policy_form.step_#{step}_title") %></h3>
        <p class="mt-2 text-xs leading-6 text-slate-400"><%= t("recognition_policy_form.step_#{step}_body") %></p>
      </li>
    <% end %>
  </ol>
</section>

<div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(320px,.75fr)]">
  <section class="panel min-w-0 p-6 sm:p-7" aria-labelledby="recognition-policy-form-title">
    <h2 id="recognition-policy-form-title" class="text-xl font-semibold"><%= t("recognition_policy_form.form_title") %></h2>
    <p class="mt-2 text-sm leading-7 text-slate-400"><%= t("recognition_policy_form.form_intro") %></p>

    <% if @profiles.empty? %>
      <div class="alert-warning mt-5" role="status">
        <p class="font-semibold"><%= t("recognition_policy_form.no_profiles_title") %></p>
        <p class="mt-2 text-sm"><%= t("recognition_policy_form.no_profiles_body") %></p>
        <%= link_to t("recognition_policy_form.create_profile"), new_admin_embedding_profile_path, class: "text-link mt-3 inline-block text-sm" %>
      </div>
    <% end %>

    <%= render "shared/form_errors", record: @policy %>
    <%= form_with model: [:admin, @policy], class: "mt-5 space-y-5" do |f| %>
      <div>
        <%= f.label :embedding_profile_id, t("recognition_policy_form.profile_label"), class: "field-label" %>
        <%= f.collection_select :embedding_profile_id, @profiles, :id, ->(profile) { "##{profile.id} · #{profile.embedding_model.display_name} · #{profile.dimension}D · #{profile.model_revision.first(8)}" }, { prompt: t("recognition_policy_form.profile_prompt") }, class: "field", required: true %>
        <p class="field-hint"><%= t("recognition_policy_form.profile_hint") %></p>
      </div>
      <div>
        <%= f.label :threshold, t("recognition_policy_form.threshold_label"), class: "field-label" %>
        <%= f.number_field :threshold, step: :any, min: -1, max: 1, class: "field", placeholder: t("recognition_policy_form.threshold_placeholder") %>
        <p class="field-hint"><%= t("recognition_policy_form.threshold_hint") %></p>
      </div>
      <div>
        <%= f.label :decision_margin, t("recognition_policy_form.margin_label"), class: "field-label" %>
        <%= f.number_field :decision_margin, step: :any, min: 0, max: 2, class: "field" %>
        <p class="field-hint"><%= t("recognition_policy_form.margin_hint") %></p>
      </div>
      <div>
        <%= f.label :evaluation_manifest_ref, t("recognition_policy_form.manifest_label"), class: "field-label" %>
        <%= f.text_field :evaluation_manifest_ref, class: "field", placeholder: t("recognition_policy_form.manifest_placeholder") %>
        <p class="field-hint"><%= t("recognition_policy_form.manifest_hint") %></p>
      </div>
      <div>
        <%= f.label :evaluation_report_sha256, t("recognition_policy_form.sha_label"), class: "field-label" %>
        <%= f.text_field :evaluation_report_sha256, maxlength: 64, minlength: 64, class: "field font-mono text-xs", placeholder: t("recognition_policy_form.sha_placeholder"), autocomplete: "off", spellcheck: false %>
        <p class="field-hint"><%= t("recognition_policy_form.sha_hint") %></p>
      </div>
      <div class="alert-warning"><%= t("recognition_policy_form.draft_warning") %></div>
      <div class="flex flex-wrap gap-3">
        <%= f.submit t("recognition_policy_form.save_draft"), class: "btn-primary", disabled: @profiles.empty? %>
        <%= link_to t("recognition_policy_form.cancel"), admin_recognition_policies_path, class: "btn-secondary" %>
      </div>
    <% end %>
  </section>

  <aside class="min-w-0 space-y-5">
    <section class="panel p-6 sm:p-7" aria-labelledby="recognition-policy-decision-title">
      <h2 id="recognition-policy-decision-title" class="text-lg font-semibold"><%= t("recognition_policy_form.decision_title") %></h2>
      <p class="mt-3 text-sm leading-7 text-slate-400"><%= t("recognition_policy_form.decision_intro") %></p>
      <dl class="mt-5 space-y-4">
        <% %w[unknown indeterminate matched].each do |decision| %>
          <div class="border-t border-white/10 pt-4">
            <dt class="text-sm font-semibold text-slate-100"><%= t("recognition_policy_form.#{decision}_title") %></dt>
            <dd class="mt-1 text-sm leading-6 text-slate-400"><%= t("recognition_policy_form.#{decision}_body") %></dd>
          </div>
        <% end %>
      </dl>
      <p class="mt-5 border-t border-white/10 pt-4 text-xs leading-6 text-amber-300"><%= t("recognition_policy_form.decision_note") %></p>
    </section>

    <section class="panel p-6 sm:p-7" aria-labelledby="recognition-policy-checklist-title">
      <h2 id="recognition-policy-checklist-title" class="text-lg font-semibold"><%= t("recognition_policy_form.checklist_title") %></h2>
      <ul class="mt-4 list-disc space-y-3 pl-5 text-sm leading-6 text-slate-400">
        <% (1..4).each do |item| %>
          <li><%= t("recognition_policy_form.checklist_#{item}") %></li>
        <% end %>
      </ul>
      <%= link_to t("recognition_policy_form.create_profile"), admin_embedding_profiles_path, class: "text-link mt-5 inline-block text-sm" %>
    </section>
  </aside>
</div>
