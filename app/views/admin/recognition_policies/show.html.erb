<% content_for :title, "Recognition Policy ##{@policy.id} · Rails 8 Face Recognition" %>
<%= link_to "← Recognition policies", admin_recognition_policies_path, class: "text-link text-sm" %>
<div class="mt-5 flex flex-wrap items-center justify-between gap-4"><div><p class="section-kicker"><%= ui('Administration / Policy #') %><%= @policy.id %></p><h1 class="page-title"><%= ui('Evaluation policy') %></h1></div><%= status_badge @policy.status %></div>
<div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]"><section class="panel space-y-6 p-7"><div><p class="detail-label"><%= ui('Pinned profile') %></p><p class="detail-value"><%= link_to "#{@policy.embedding_profile.embedding_model.display_name} · #{@policy.embedding_profile.dimension}D · profile ##{@policy.embedding_profile_id}", admin_embedding_profile_path(@policy.embedding_profile), class: "text-link" %></p></div><div class="grid grid-cols-2 gap-5"><div><p class="detail-label"><%= ui('Threshold') %></p><p class="mt-2 text-3xl font-semibold tabular-nums"><%= @policy.threshold.nil? ? "—" : number_with_precision(@policy.threshold, precision: 5) %></p></div><div><p class="detail-label"><%= ui('Decision margin') %></p><p class="mt-2 text-3xl font-semibold tabular-nums"><%= @policy.decision_margin.nil? ? "—" : number_with_precision(@policy.decision_margin, precision: 5) %></p></div></div><div><p class="detail-label"><%= ui('Evaluation manifest reference') %></p><p class="detail-value break-all"><%= @policy.evaluation_manifest_ref || ui("Not provided") %></p></div><div><p class="detail-label"><%= ui('Report SHA-256') %></p><p class="detail-value break-all font-mono text-xs"><%= @policy.evaluation_report_sha256 || ui("Not provided") %></p></div><div><p class="detail-label"><%= ui('Approved by / at') %></p><p class="detail-value"><%= @policy.approved_by&.email || ui("Not approved") %> · <%= short_time(@policy.approved_at) %></p></div></section>
<section class="panel p-7"><h2 class="text-xl font-semibold"><%= ui('Review actions') %></h2><p class="mt-3 text-sm leading-7 text-slate-400"><%= ui('Approval affirms that the externally evaluated threshold has been reviewed for the exact model, revision and dimension. It does not automatically activate recognition.') %></p><% if @policy.status == "not_calibrated" %><%= button_to ui("Approve policy"), approve_admin_recognition_policy_path(@policy), method: :post, class: "btn-primary mt-6 w-full", form: { data: { turbo_confirm: ui("Confirm you reviewed this external report, dataset split, threshold and model configuration?") } } %><% elsif @policy.status == "approved" %><%= button_to ui("Retire policy"), retire_admin_recognition_policy_path(@policy), method: :post, class: "btn-danger mt-6 w-full", form: { data: { turbo_confirm: ui("Retire this policy? Active policies must be deactivated first.") } } %><% end %><div class="alert-info mt-6"><%= ui('Threshold ≠ probability of correct identity. Synthetic evaluation does not prove real-world performance.') %></div></section></div>
