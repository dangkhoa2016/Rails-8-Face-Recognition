<% content_for :title, "#{t('nav.audits')} · Rails 8 Face Recognition" %>
<%= render "shared/page_header", eyebrow: ui("Administration / Governance"), title: ui("Audit events"), description: ui("Administrative changes are recorded without storing raw secrets, uploaded image bytes or embedding vectors.") %>
<% if @events.empty? %><div class="mt-8"><%= render "shared/empty", title: ui("No administrative events"), description: ui("Configuration changes and import actions will appear here after they occur.") %></div><% else %><div class="table-wrap mt-8"><table class="data-table"><thead><tr><th><%= ui('Event') %></th><th><%= ui('Object') %></th><th><%= ui('Actor') %></th><th><%= ui('Timestamp') %></th></tr></thead><tbody><% @events.each do |event| %><tr><td class="font-semibold text-white"><%= t("admin_indexes.audit_actions.#{event.action.tr('.', '_')}", default: event.action) %><p class="mt-1 font-mono text-xs font-normal text-slate-500"><%= event.action %></p></td><td class="text-xs"><%= t("admin_indexes.audit_objects.#{event.subject_type.underscore}", default: event.subject_type) %> #<%= event.subject_id %></td><td><%= event.actor.email %></td><td><%= short_time(event.created_at) %></td></tr><% end %></tbody></table></div><% end %>
