<% content_for :title, "#{t('nav.imports')} · Rails 8 Face Recognition" %>
<%= render "shared/page_header", eyebrow: ui("Administration / Dataset"), title: ui("Dataset imports"), description: ui("Register, verify and import a pinned CompactFaces snapshot. All 935 file checksums and 187 five-slot identity groups are verified before image records are imported."), action_text: ui("+ Register snapshot"), action_path: new_admin_dataset_import_path %>
<% if @imports.empty? %><div class="mt-8"><%= render "shared/empty", title: ui("No dataset imports"), description: ui("Register a dataset snapshot, configure the local dataset root and verify its integrity before enrolling 120 Core SOURCE images."), action_text: ui("Register snapshot"), action_path: new_admin_dataset_import_path %></div><% else %>
<div class="table-wrap mt-8"><table class="data-table"><thead><tr><th><%= ui('Dataset source') %></th><th><%= ui('Version') %></th><th><%= ui('Status') %></th><th><%= ui('Verified files') %></th><th><%= ui('Started') %></th><th><%= ui('Details') %></th></tr></thead><tbody><% @imports.each do |item| %><tr><td class="font-semibold text-white"><%= item.source_name %></td><td><%= item.dataset_version %></td><td><%= status_badge(item.import_status) %></td><td class="tabular-nums"><%= item.verified_file_count %>/935</td><td><%= short_time(item.started_at) %></td><td><%= link_to ui("Inspect →"), admin_dataset_import_path(item), class: "text-link" %></td></tr><% end %></tbody></table></div><% end %>
