<% content_for :title, "Register Dataset · Rails 8 Face Recognition" %>
<%= link_to "← Dataset imports", admin_dataset_imports_path, class: "text-link text-sm" %>
<%= render "shared/page_header", eyebrow: ui("Administration / New snapshot"), title: ui("Register dataset source"), description: ui("This step records provenance only; it does not fetch arbitrary URLs or execute remote code. Import will read DATASET_IMPORT_ROOT on the trusted server.") %>
<div class="panel mt-8 max-w-3xl p-7"><%= render "shared/form_errors", record: @dataset_import %><%= form_with model: [:admin, @dataset_import], class: "mt-5 space-y-5" do |f| %><div><%= f.label :source_name, class: "field-label" %><%= f.text_field :source_name, required: true, class: "field" %></div><div><%= f.label :source_url, ui("Reference source URL"), class: "field-label" %><%= f.url_field :source_url, required: true, class: "field" %></div><div><%= f.label :dataset_version, class: "field-label" %><%= f.text_field :dataset_version, required: true, class: "field" %></div><div class="alert-info"><%= ui('The import job never downloads files from this URL. An operator must stage an authorized snapshot on the application host and configure DATASET_IMPORT_ROOT.') %></div><div class="flex gap-3"><%= f.submit ui("Register snapshot"), class: "btn-primary" %><%= link_to ui("Cancel"), admin_dataset_imports_path, class: "btn-secondary" %></div><% end %></div>
