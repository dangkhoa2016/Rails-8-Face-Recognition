<% content_for :title, "#{t('nav.unknown')} · Rails 8 Face Recognition" %>
<%= render "shared/page_header", eyebrow: ui("Administration / Manual QA"), title: ui("Unknown tests"), description: ui("Authorized manual probes outside the Core enrollment directory. An asserted unknown label is an operator claim, not verified ground truth or a quality benchmark."), action_text: ui("+ New unknown test"), action_path: new_admin_unknown_test_path %>
<% if @images.empty? %><div class="mt-8"><%= render "shared/empty", title: ui("No manual unknown tests"), description: ui("Upload an authorized image to inspect its behavior against the active Core gallery. A confirmed false accept requires verified ground truth."), action_text: ui("New unknown test"), action_path: new_admin_unknown_test_path %></div><% else %><div class="table-wrap mt-8"><table class="data-table"><thead><tr><th><%= ui('Image') %></th><th><%= ui('Label') %></th><th><%= ui('Owner') %></th><th><%= ui('Expiry') %></th><th><%= ui('Details') %></th></tr></thead><tbody><% @images.each do |image| %><tr><td>#<%= image.id %> · <span class="font-mono text-xs text-slate-500"><%= short_sha(image.original_sha256) %></span></td><td><%= status_badge(image.ground_truth_label) %></td><td><%= image.owner_user.email %></td><td><%= short_time(image.expires_at) %></td><td><%= link_to ui("Review →"), admin_unknown_test_path(image), class: "text-link" %></td></tr><% end %></tbody></table></div><% end %>
