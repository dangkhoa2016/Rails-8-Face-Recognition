<% content_for :title, "New Unknown Test · Rails 8 Face Recognition" %>
<%= link_to "← Unknown tests", admin_unknown_tests_path, class: "text-link text-sm" %>
<%= render "shared/page_header", eyebrow: ui("Administration / Manual QA"), title: ui("Create an unknown-case probe"), description: ui("Upload an image you are authorized to process. This is a query submission, not a newly enrolled identity, and it expires after 24 hours.") %>
<% if @error_message %><div class="alert-error mt-6"><%= @error_message %></div><% end %>
<%= form_with url: admin_unknown_tests_path, multipart: true, class: "panel mt-8 max-w-3xl space-y-6 p-7" do |f| %><div><%= f.label :image, ui("Authorized face image"), class: "field-label" %><%= f.file_field :image, required: true, accept: "image/png,image/jpeg,image/webp", class: "field" %><p class="field-hint"><%= ui('PNG/JPEG/WebP · ≤5 MiB · ≤12 MP · pre-cropped single face.') %></p></div><div><%= f.label :provenance_note, ui("Provenance note (optional)"), class: "field-label" %><%= f.text_area :provenance_note, maxlength: 2000, rows: 3, class: "field", placeholder: ui("Known acquisition/authorization context; do not include personal identifiers") %></div><div class="alert-warning"><%= ui('This record is labeled') %> <strong><%= ui('asserted_unknown') %></strong><%= ui('. It does not become verified_unknown automatically, even if the model returns a Core candidate.') %></div><label class="flex items-start gap-3 rounded-xl border border-white/10 p-4 text-sm leading-6"><%= check_box_tag :consent, "1", false, required: true, class: "mt-1 h-4 w-4 accent-cyan-300" %><span><%= ui('I confirm that this image may legally be processed and that any required consent has been obtained.') %></span></label><div class="flex gap-3"><%= f.submit ui("Upload private probe"), class: "btn-primary", data: { turbo_submits_with: ui("Uploading…") } %><%= link_to ui("Cancel"), admin_unknown_tests_path, class: "btn-secondary" %></div><% end %>
