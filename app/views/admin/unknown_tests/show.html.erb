<% content_for :title, "Unknown Test ##{@image.id} · Rails 8 Face Recognition" %>
<%= link_to "← Unknown tests", admin_unknown_tests_path, class: "text-link text-sm" %>
<div class="mt-5 flex flex-wrap items-center justify-between gap-4"><div><p class="section-kicker"><%= ui('Administration / Unknown probe') %></p><h1 class="page-title"><%= ui('Manual test #') %><%= @image.id %></h1></div><%= status_badge @image.ground_truth_label %></div>
<div class="mt-7 grid gap-6 lg:grid-cols-2"><div class="panel overflow-hidden"><% if @image.image.attached? && @image.expires_at.future? %><%= image_tag face_image_path(@image), alt: ui("Admin-provided authorized unknown probe"), class: "max-h-[650px] w-full object-contain" %><% else %><p class="p-10 text-slate-500"><%= ui('Image has expired or is unavailable.') %></p><% end %></div><div class="space-y-5"><div class="panel space-y-5 p-7"><h2 class="font-semibold"><%= ui('Provenance') %></h2><div><p class="detail-label"><%= ui('Claimed ground truth') %></p><p class="detail-value"><%= @image.ground_truth_label %> <%= ui('(not independently verified)') %></p></div><div><p class="detail-label"><%= ui('Expires') %></p><p class="detail-value"><%= short_time(@image.expires_at) %></p></div><div><p class="detail-label"><%= ui('Operator note') %></p><p class="detail-value"><%= @image.provenance_note.presence || ui("No note") %></p></div></div><% if @image.owner_user_id == current_user.id && @image.expires_at.future? && @image.image.attached? %><%= button_to ui("Try against active gallery"), recognition_attempts_path(face_image_id: @image.id), method: :post, class: "btn-primary w-full" %><% elsif @image.owner_user_id != current_user.id %><p class="text-sm text-slate-400"><%= ui('Only the operator who submitted this probe may initiate its recognition request.') %></p><% end %><%= button_to ui("Delete test and records"), admin_unknown_test_path(@image), method: :delete, class: "btn-danger w-full", form: { data: { turbo_confirm: ui("Permanently delete this image, vectors and recognition attempts?") } } %>
<div class="panel p-7"><h2 class="font-semibold"><%= ui('Recognition requests') %></h2><% if @attempts.any? %><div class="mt-4 space-y-3"><% @attempts.each do |a| %><div class="flex items-center justify-between text-sm"><span>#<%= a.id %> · <%= a.top_similarity ? number_with_precision(a.top_similarity, precision: 4) : "—" %></span><%= status_badge a.decision %></div><% end %></div><% else %><p class="mt-3 text-sm text-slate-500"><%= ui('No requests yet.') %></p><% end %></div><div class="alert-warning"><%= ui('Matching a claimed unknown probe is a potential false match requiring ground-truth review; it is not automatically a verified false accept.') %></div></div></div>
