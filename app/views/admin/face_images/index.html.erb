<% content_for :title, "#{t('nav.images')} · Rails 8 Face Recognition" %>
<%= render "shared/page_header", eyebrow: ui("Administration / Data"), title: ui("Face images"), description: ui("Dataset references and private submissions are tracked separately. Only active Core SOURCE records can enter the recognition gallery.") %>
<%= form_with url: admin_face_images_path, method: :get, class: "panel mt-8 flex flex-wrap items-end gap-3 p-5" do |f| %><div class="min-w-40 flex-1"><%= f.label :collection, ui("Collection"), class: "field-label" %><%= f.select :collection, [[ui("All"), ""]] + FaceImage::COLLECTIONS.map { |c| [t("admin_indexes.collections.#{c}"), c] }, { selected: @collection }, class: "field" %></div><div class="min-w-40 flex-1"><%= f.label :role, ui("Role"), class: "field-label" %><%= f.select :role, [[ui("All"), ""]] + FaceImage::ROLES.map { |r| [t("admin_indexes.roles.#{r}"), r] }, { selected: @role }, class: "field" %></div><%= f.submit ui("Apply filters"), class: "btn-primary" %><%= link_to ui("Reset"), admin_face_images_path, class: "btn-quiet" %><% end %>
<% if @total.zero? %><div class="mt-6"><%= render "shared/empty", title: ui("No matching images"), description: ui("No source images are available yet, or the selected filters exclude them.") %></div><% else %><div class="table-wrap mt-6"><table class="data-table"><thead><tr><th><%= ui('Image') %></th><th><%= ui('Collection') %></th><th><%= ui('Slot') %></th><th><%= ui('Role') %></th><th><%= ui('Profile vectors') %></th><th><%= ui('Details') %></th></tr></thead><tbody><% @images.each do |img| %><tr><td><span class="font-semibold">#<%= img.id %></span><p class="mt-1 font-mono text-xs text-slate-500"><%= img.dataset_identity_key || short_sha(img.original_sha256) %></p></td><td><%= t("admin_indexes.collections.#{img.collection}") %></td><td><%= img.slot || "—" %></td><td><%= status_badge(img.role) %></td><td><%= img.face_embeddings.count %></td><td><%= link_to ui("Inspect →"), admin_face_image_path(img), class: "text-link" %></td></tr><% end %></tbody></table></div><%= render "shared/pager", total: @total, page: @page, per_page: 40 %><% end %>
