<% content_for :title, "Face Image ##{@image.id} · Rails 8 Face Recognition" %>
<%= link_to "← Face images", admin_face_images_path, class: "text-link text-sm" %>
<%= render "shared/page_header", eyebrow: ui("Administration / Data"), title: "Image ##{@image.id}", description: ui("Immutable image identity and embedding cache associations.") %>
<div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(320px,1fr)]"><div class="panel overflow-hidden"><% if @image.image.attached? && (@image.role != "submission" || @image.collection == "admin" || @image.owner_user_id == current_user.id) && (@image.storage_policy == "reference" || @image.expires_at&.future?) %><%= image_tag face_image_path(@image), alt: ui("Stored face image"), class: "max-h-[650px] w-full object-contain" %><% else %><p class="p-10 text-slate-500"><%= ui('No accessible image attachment.') %></p><% end %></div><div class="space-y-5"><div class="panel grid grid-cols-2 gap-5 p-6"><% [[ui("Collection"), @image.collection], [ui("Slot"), @image.slot || "—"], [ui("Role"), @image.role], ["Storage", @image.storage_policy], [ui("Owner"), @image.owner_user_id || "Dataset"], [ui("Expires"), short_time(@image.expires_at)]].each do |label, value| %><div><p class="detail-label"><%= label %></p><p class="detail-value"><%= value %></p></div><% end %><div class="col-span-2"><p class="detail-label"><%= ui('Original SHA-256') %></p><p class="detail-value break-all font-mono text-xs"><%= @image.original_sha256 %></p></div></div><div class="panel p-6"><h2 class="font-semibold"><%= ui('Stored embeddings (') %><%= @embeddings.size %>)</h2><% if @embeddings.any? %><div class="mt-4 space-y-3"><% @embeddings.each do |e| %><div class="flex justify-between gap-3 border-b border-white/10 pb-3 text-sm"><span><%= e.embedding_profile.embedding_model.display_name %> · <%= e.embedding_profile.dimension %>D</span><span class="text-slate-500"><%= short_time(e.created_at) %></span></div><% end %></div><% else %><p class="mt-4 text-sm text-slate-500"><%= ui('No vectors generated for this image yet.') %></p><% end %></div></div></div>
