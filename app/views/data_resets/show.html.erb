<% content_for :title, "#{t('resets.title')} ##{@reset.id}" %>
<%= render 'shared/page_header', title: "#{t('resets.title')} ##{@reset.id}", description: t('resets.description') %>
<% if %w[pending running].include?(@reset.status) %><div data-controller="poll" data-poll-interval-value="5000"></div><% end %>
<div class="panel mt-8 p-7"><dl class="grid gap-5 sm:grid-cols-2"><div><dt class="detail-label"><%= t('resets.scope') %></dt><dd class="detail-value"><%= t("resets.scope_#{@reset.scope}") %></dd></div><div><dt class="detail-label"><%= t('resets.status') %></dt><dd class="detail-value"><%= status_badge(@reset.status) %></dd></div><div><dt class="detail-label"><%= t('resets.deleted_submissions') %></dt><dd class="detail-value"><%= @reset.deleted_submissions %></dd></div><div><dt class="detail-label"><%= t('resets.deleted_attempts') %></dt><dd class="detail-value"><%= @reset.deleted_attempts %></dd></div><div><dt class="detail-label"><%= t('resets.deleted_embeddings') %></dt><dd class="detail-value"><%= @reset.deleted_embeddings %></dd></div><div><dt class="detail-label"><%= t('resets.deleted_embedding_requests') %></dt><dd class="detail-value"><%= @reset.deleted_embedding_requests %></dd></div></dl></div>
<%= link_to t('resets.back'), data_resets_path, class: 'btn-secondary mt-6' %>
