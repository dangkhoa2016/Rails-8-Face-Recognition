<article class="panel group overflow-hidden">
  <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-[#1c3147] via-[#111b30] to-indigo-950">
    <% if image.image.attached? %>
      <%= image_tag face_image_path(image), alt: "Synthetic face sample #{image.dataset_identity_key}, #{image.slot}", class: "h-full w-full object-cover transition duration-300 group-hover:scale-[1.025]", loading: "lazy" %>
    <% else %>
      <div class="flex h-full items-center justify-center text-sm text-slate-500"><%= ui('Image not available') %></div>
    <% end %>
    <div class="absolute left-3 top-3"><%= status_badge(image.collection) %></div>
  </div>
  <div class="space-y-3 p-5">
    <div><p class="font-semibold text-white"><%= image.dataset_identity_key %></p><p class="mt-1 text-xs text-slate-500"><%= image.slot %> <%= ui('· Query only · Not enrolled') %></p></div>
    <%= link_to ui("View sample →"), sample_path(image), class: "text-link inline-block text-sm" %>
  </div>
</article>
