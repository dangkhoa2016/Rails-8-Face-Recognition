<div class="panel-soft px-6 py-14 text-center sm:px-12">
  <div class="mx-auto mb-5 grid h-14 w-14 place-items-center rounded-2xl border border-cyan-400/20 bg-cyan-400/10 text-2xl text-cyan-300" aria-hidden="true">◈</div>
  <h2 class="text-xl font-semibold text-white"><%= title %></h2>
  <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-slate-400"><%= description %></p>
  <% if local_assigns[:action_path].present? %><%= link_to action_text, action_path, class: "btn-secondary mt-6" %><% end %>
</div>
