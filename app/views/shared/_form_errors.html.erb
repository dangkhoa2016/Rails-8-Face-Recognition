<% if record.errors.any? %>
  <div role="alert" class="alert-error">
    <p class="font-semibold"><%= ui('Please correct these fields:') %></p>
    <ul class="mt-2 list-inside list-disc space-y-1"><% record.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
  </div>
<% end %>
