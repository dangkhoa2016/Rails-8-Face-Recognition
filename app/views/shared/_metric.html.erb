<div class="panel p-5 sm:p-6">
  <p class="text-xs font-medium uppercase tracking-wider text-slate-500"><%= label %></p>
  <p class="mt-4 break-words text-3xl font-semibold tracking-tight text-white sm:text-4xl"><%= value %></p>
  <% if supporting.present? %><p class="mt-2 text-xs text-slate-500"><%= supporting %></p><% end %>
</div>
