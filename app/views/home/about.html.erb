<% content_for :title, "#{ui('About')} · Rails 8 Face Recognition" %>
<%= render "shared/page_header", eyebrow: ui("Research / Transparency"), title: ui("Built for careful recognition research"), description: ui("A bounded 1:N identification demonstration using the CompactFaces synthetic dataset. Provenance and file integrity do not prove biometric identity consistency.") %>
<div class="mt-9 grid gap-5 lg:grid-cols-2">
  <section class="panel p-7"><p class="section-kicker"><%= ui('01 / Dataset') %></p><h2 class="mt-4 text-xl font-semibold"><%= ui('120 enrolled Core identities') %></h2><p class="mt-3 text-sm leading-7 text-slate-400"><%= ui('Each Core identity has one SOURCE reference image and four held-out pose/expression probes. A separate Additional collection provides 67 identities that are never enrolled. The full dataset contains 935 synthetic PNGs.') %></p></section>
  <section class="panel p-7"><p class="section-kicker"><%= ui('02 / Inference') %></p><h2 class="mt-4 text-xl font-semibold"><%= ui('External GPU, local decisions') %></h2><p class="mt-3 text-sm leading-7 text-slate-400"><%= ui('Rails calls a server-side authenticated Modal embedding endpoint. PostgreSQL/pgvector keeps model and dimension profiles separate; private Cloudflare R2 stores reference and uploaded images.') %></p></section>
  <section class="panel p-7"><p class="section-kicker"><%= ui('03 / Calibration') %></p><h2 class="mt-4 text-xl font-semibold"><%= ui('No invented confidence score') %></h2><p class="mt-3 text-sm leading-7 text-slate-400"><%= ui('Cosine similarity is not a probability. Every threshold needs a reviewed evaluation report from an independent notebook. Without an approved policy and complete gallery, recognition is disabled.') %></p></section>
  <section class="panel p-7"><p class="section-kicker"><%= ui('04 / Limits') %></p><h2 class="mt-4 text-xl font-semibold"><%= ui('Single pre-cropped face only') %></h2><p class="mt-3 text-sm leading-7 text-slate-400"><%= ui('Face detection, alignment, multiple faces and camera capture are not supported in this workflow. Qwen and WeMM are multimodal embedding models, not yet proven specialist face-recognition systems.') %></p></section>
</div>
<div class="panel mt-6 p-7"><h2 class="text-lg font-semibold"><%= ui('Credits and license boundaries') %></h2><p class="mt-3 text-sm leading-7 text-slate-400"><%= ui('CompactFaces imagery carries separate non-commercial licensing restrictions. The Rails code is MIT-licensed, and upstream model licenses remain in effect. Review dataset attribution and provenance before use.') %> <%= link_to ui('Source dataset'), 'https://huggingface.co/datasets/dangkhoa2016/compactfaces-synthetic-face-dataset', class: 'text-link' %></p></div>
