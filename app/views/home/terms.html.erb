<% content_for :title, "Terms · Rails 8 Face Recognition" %>
<%= render "shared/page_header", eyebrow: ui("Research / Acceptable use"), title: ui("Use this demo responsibly"), description: ui("These conditions explain permitted use while the application is being evaluated.") %>
<div class="mt-8 space-y-5">
  <div class="panel p-7"><h2 class="text-lg font-semibold"><%= ui('Authorized images only') %></h2><p class="mt-3 text-sm leading-7 text-slate-400"><%= ui('Upload only images you own or are explicitly authorized to process, with any consent required by the relevant laws and context. Do not upload photos of others without permission or scrape images from the internet for identification.') %></p></div>
  <div class="panel p-7"><h2 class="text-lg font-semibold"><%= ui('Research use; not verified biometric evidence') %></h2><p class="mt-3 text-sm leading-7 text-slate-400"><%= ui('Results are experimental and should not support access control, employment, attendance, legal or other high-impact decisions. An "Unknown" decision means evidence did not satisfy the selected gallery policy, not that the person is unknown in the real world.') %></p></div>
  <div class="panel p-7"><h2 class="text-lg font-semibold"><%= ui('Dataset and model attribution') %></h2><p class="mt-3 text-sm leading-7 text-slate-400"><%= ui('Synthetic CompactFaces images have separate non-commercial licensing restrictions. Model checkpoints and other third-party assets retain their respective licenses.') %></p></div>
</div>
