<% content_for :title, "#{t('auth.new_password')} · Rails 8 Face Recognition" %>
<div class="mx-auto max-w-lg panel p-8"><h1 class="page-title"><%= t('auth.new_password') %></h1>
<% if @valid %>
  <% if @errors.present? %><div class="alert-error mt-4"><%= safe_join(@errors.map { |error| content_tag(:p, error) }) %></div><% end %>
  <%= form_with url: update_password_reset_path, method: :patch, class: 'mt-7 space-y-5' do |f| %>
    <%= f.hidden_field :token, value: @token %>
    <div><%= f.label :password, t('auth.new_password'), class: 'field-label' %><%= f.password_field :password, class: 'field', required: true, minlength: 12, autocomplete: 'new-password' %></div>
    <div><%= f.label :password_confirmation, t('auth.password_confirmation'), class: 'field-label' %><%= f.password_field :password_confirmation, class: 'field', required: true, minlength: 12, autocomplete: 'new-password' %></div>
    <%= f.submit t('auth.change_password'), class: 'btn-primary w-full' %>
  <% end %>
<% else %><p class="alert-warning mt-6"><%= t('auth.link_expired') %></p><%= link_to t('auth.forgot_password'), new_password_reset_path, class: 'btn-secondary mt-5' %><% end %>
</div>
