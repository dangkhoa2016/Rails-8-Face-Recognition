<% content_for :title, "Recognition ##{@attempt.id} · Rails 8 Face Recognition" %>
<%= link_to "← Recognition history", recognition_attempts_path, class: "text-link text-sm" %>
<div class="mt-5 flex flex-wrap items-center justify-between gap-4"><div><p class="section-kicker"><%= ui('Request') %> #<%= @attempt.id %></p><h1 class="page-title"><%= ui('Result details') %></h1></div><%= status_badge(@attempt.decision) %></div>
<% if @attempt.decision == "pending" %><div data-controller="poll" data-poll-interval-value="6000" class="alert-info mt-7" role="status"><%= ui('Your request is queued or being processed. This page refreshes while the result is pending. No identity claim has been made.') %></div><% end %>
<div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(340px,1fr)]">
  <section class="panel overflow-hidden"><% if @can_view_image && @sample.image.attached? && (@sample.storage_policy == "reference" || @sample.expires_at&.future?) %><%= image_tag face_image_path(@sample), alt: ui("Recognition input image"), class: "max-h-[550px] w-full object-contain" %><% else %><p class="p-8 text-sm text-slate-500"><%= ui('Input image is no longer available.') %></p><% end %><div class="border-t border-white/10 px-6 py-4 text-xs text-slate-500"><%= ui('Input image ·') %> <%= @sample.collection %> · <%= @sample.role %></div></section>
  <div class="space-y-5">
    <section class="panel p-7"><p class="section-kicker"><%= ui('Decision') %></p>
      <% if @attempt.decision == "matched" %><h2 class="mt-3 text-2xl font-semibold text-emerald-300"><%= ui('Matched candidate') %></h2><p class="mt-3 text-sm text-slate-300"><%= ui('Candidate:') %> <%= @attempt.result_identity&.display_name %></p>
      <% elsif @attempt.decision == "unknown" %><h2 class="mt-3 text-2xl font-semibold text-amber-300"><%= ui('Unknown to this gallery') %></h2><p class="mt-3 text-sm leading-6 text-slate-400"><%= ui("The score did not satisfy this profile's approved threshold, not proof that an identity is absent outside the gallery.") %></p>
      <% elsif @attempt.decision == "indeterminate" %><h2 class="mt-3 text-2xl font-semibold text-amber-300"><%= ui('Indeterminate') %></h2><p class="mt-3 text-sm text-slate-400"><%= ui('The available evidence was insufficient for a confident gallery decision.') %></p>
      <% elsif @attempt.decision == "failed" %><h2 class="mt-3 text-2xl font-semibold text-rose-300"><%= ui('Processing failed') %></h2><p class="mt-3 text-sm text-slate-400"><%= ui('Error category:') %> <%= @attempt.error_code %><%= ui('. No identity decision was made.') %></p>
      <% else %><h2 class="mt-3 text-2xl font-semibold"><%= ui('Processing') %></h2><p class="mt-3 text-sm text-slate-400"><%= ui('The external inference service may be starting a GPU worker.') %></p>
      <% end %>
      <div class="mt-6 border-t border-white/10 pt-5"><p class="detail-label"><%= ui('Top cosine similarity') %></p><p class="mt-2 text-3xl font-semibold tabular-nums"><%= @attempt.top_similarity ? number_with_precision(@attempt.top_similarity, precision: 5) : "—" %></p><p class="mt-2 text-xs text-slate-500"><%= ui('Cosine similarity is not a percentage probability.') %></p></div>
    </section>
    <section class="panel grid gap-5 p-7"><h2 class="font-semibold"><%= ui('Configuration snapshot') %></h2><div><p class="detail-label"><%= ui('Model') %></p><p class="detail-value"><%= @attempt.embedding_profile.embedding_model.display_name %></p></div><div><p class="detail-label"><%= ui('Dimension / revision') %></p><p class="detail-value"><%= @attempt.embedding_profile.dimension %>D · <%= short_sha(@attempt.embedding_profile.model_revision) %></p></div><div><p class="detail-label"><%= ui('Policy') %></p><p class="detail-value">#<%= @attempt.recognition_policy_id || ui("None") %></p></div><div><p class="detail-label"><%= ui('Submitted') %></p><p class="detail-value"><%= short_time(@attempt.created_at) %></p></div></section>
    <%= button_to ui("Delete this result"), recognition_attempt_path(@attempt), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: ui("Remove this recognition result from your history?") } } %>
  </div>
</div>
