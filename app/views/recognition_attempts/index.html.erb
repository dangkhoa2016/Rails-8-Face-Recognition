<% content_for :title, "Recognition History · Rails 8 Face Recognition" %>
<%= render "shared/page_header", eyebrow: ui("Workspace / Results"), title: ui("Recognition history"), description: ui("Your attempts are scoped to your account. Each request preserves the exact profile and policy selected at submission time."), action_text: "+ New request", action_path: new_recognition_attempt_path %>
<% if @attempts.empty? %><div class="mt-8"><%= render "shared/empty", title: ui("No recognition attempts"), description: ui("Choose a licensed synthetic sample or upload an image you have permission to process."), action_text: ui("Try recognition"), action_path: new_recognition_attempt_path %></div><% else %>
<div class="table-wrap mt-8"><table class="data-table"><thead><tr><th><%= ui('Request') %></th><th><%= ui('Image') %></th><th><%= ui('Profile') %></th><th><%= ui('Decision') %></th><th><%= ui('Similarity') %></th><th><%= ui('Created') %></th></tr></thead><tbody>
<% @attempts.each do |a| %><tr><td><%= link_to "##{a.id}", recognition_attempt_path(a), class: "text-link" %></td><td><%= a.query_face_image.collection %></td><td><%= a.embedding_profile.dimension %>D</td><td><%= status_badge(a.decision) %></td><td class="tabular-nums"><%= a.top_similarity ? number_with_precision(a.top_similarity, precision: 4) : "—" %></td><td><%= short_time(a.created_at) %></td></tr><% end %>
</tbody></table></div><% end %>
