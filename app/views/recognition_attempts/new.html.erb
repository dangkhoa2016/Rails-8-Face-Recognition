<% content_for :title, "Try Recognition · Rails 8 Face Recognition" %>
<%= render "shared/page_header", eyebrow: ui("Workspace / 1:N identification"), title: ui("Try recognition"), description: ui("Choose a synthetic sample or a privately uploaded, pre-cropped image. The active model and policy are snapshotted for each request.") %>
<% unless @setting.active_recognition_profile&.coverage_complete? && @setting.active_recognition_policy&.status == "approved" %>
  <div class="alert-warning mt-8"><strong><%= ui('Recognition is unavailable.') %></strong> <%= ui('The administrator must import all 120 Core SOURCE images, generate valid embeddings and activate a calibrated, approved policy. No unverified results will be presented.') %></div>
<% else %>
  <div class="panel mt-8 p-7"><p class="section-kicker"><%= ui('Active configuration') %></p><h2 class="mt-3 text-xl font-semibold"><%= @setting.active_recognition_profile.embedding_model.display_name %> · <%= @setting.active_recognition_profile.dimension %> <%= ui('dimensions') %></h2><p class="mt-2 text-sm text-slate-400"><%= ui('Revision') %> <%= short_sha(@setting.active_recognition_profile.model_revision) %> <%= ui('· Approved policy #') %><%= @setting.active_recognition_policy_id %></p></div>
<% end %>
<div class="mt-7 grid gap-6 lg:grid-cols-2">
  <section class="panel p-7"><h2 class="text-xl font-semibold"><%= ui('Sample image') %></h2><p class="mt-2 text-sm leading-6 text-slate-400"><%= ui('Explore Core and Additional pose/expression probes supplied by the dataset.') %></p><% if @sample %><div class="mt-5 flex items-center gap-4"><% if @sample.image.attached? %><%= image_tag face_image_path(@sample), alt: ui("Selected sample"), class: "h-20 w-20 rounded-xl object-cover" %><% end %><div class="text-sm"><p class="font-semibold"><%= @sample.dataset_identity_key %></p><p class="text-slate-500"><%= @sample.slot %> · <%= @sample.collection %></p></div></div><%= button_to ui("Recognize selected sample"), recognition_attempts_path(face_image_id: @sample.id), method: :post, class: "btn-primary mt-5", disabled: !(@setting.active_recognition_profile&.coverage_complete? && @setting.active_recognition_policy&.status == "approved") %><% end %><%= link_to ui("Browse sample gallery →"), samples_path, class: "btn-secondary mt-5" %></section>
  <section class="panel p-7"><h2 class="text-xl font-semibold"><%= ui('My private upload') %></h2><p class="mt-2 text-sm leading-6 text-slate-400"><%= ui('Use a previously uploaded image. Only you can access it.') %></p>
    <% if @submissions.any? %><%= form_with url: recognition_attempts_path, class: "mt-6 space-y-4" do |f| %><%= f.label :face_image_id, ui("Choose your image"), class: "field-label" %><%= f.select :face_image_id, @submissions.map { |s| ["Submission ##{s.id} · #{short_time(s.created_at)}", s.id] }, { prompt: ui("Select an upload") }, class: "field", required: true %><%= f.submit ui("Run recognition"), class: "btn-primary", disabled: !(@setting.active_recognition_profile&.coverage_complete? && @setting.active_recognition_policy&.status == "approved"), data: { turbo_submits_with: ui("Queuing…") } %><% end %><% else %><p class="mt-5 text-sm text-slate-500"><%= ui('No active uploads available.') %></p><% end %>
    <%= link_to ui("Upload authorized image →"), new_submission_path, class: "btn-secondary mt-5" %>
  </section>
</div>
<div class="alert-info mt-7"><%= ui('An "Unknown" result indicates insufficient evidence under the approved gallery threshold. A cosine score is not a probability, and this app does not automatically verify single-face images.') %></div>
