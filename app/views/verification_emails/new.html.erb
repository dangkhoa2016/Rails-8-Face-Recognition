<% content_for :title, "#{t('auth.resend_verification')} · Rails 8 Face Recognition" %>
<div class="mx-auto max-w-lg panel p-8"><h1 class="page-title"><%= t('auth.resend_verification') %></h1>
<p class="page-description"><%= t('auth.resend_intro') %></p>
<%= form_with url: verification_email_path, class: 'mt-7 space-y-4' do |f| %>
  <%= f.label :email, t('auth.email'), class: 'field-label' %>
  <%= f.email_field :email, class: 'field', required: true, autocomplete: 'email' %>
  <%= f.submit t('auth.send_email'), class: 'btn-primary w-full' %>
<% end %>
<div class="mt-6 flex flex-wrap items-center justify-center gap-4 border-t border-white/10 pt-6 text-sm">
  <%= link_to t('nav.sign_in'), sign_in_path, class: 'text-link' %>
  <%= link_to t('auth.register'), new_registration_path, class: 'text-link' %>
</div>
</div>
