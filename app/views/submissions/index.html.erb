<% content_for :title, "My Submissions · Rails 8 Face Recognition" %>
<%= render "shared/page_header", eyebrow: ui("Workspace / Private uploads"), title: ui("My submissions"), description: ui("Review and delete your own image submissions. Images expire 24 hours after upload and are never added to the Core enrollment gallery."), action_text: "+ Upload image", action_path: new_submission_path %>
<% if @submissions.empty? %><div class="mt-8"><%= render "shared/empty", title: ui("No private submissions"), description: ui("Upload a pre-cropped image with the required permissions and consent. Only your account can view it."), action_text: ui("Upload authorized image"), action_path: new_submission_path %></div><% else %>
  <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-3"><% @submissions.each do |image| %>
    <article class="panel overflow-hidden"><div class="aspect-[4/3] bg-[#182239]"><% if image.image.attached? && image.expires_at.future? %><%= image_tag face_image_path(image), alt: ui("Private uploaded image"), loading: "lazy", class: "h-full w-full object-cover" %><% else %><div class="grid h-full place-items-center text-sm text-slate-500"><%= ui('Expired or unavailable') %></div><% end %></div>
      <div class="p-5"><div class="flex items-center justify-between"><span class="badge badge-neutral"><%= ui('Private') %></span><span class="text-xs text-slate-500"><%= short_time(image.created_at) %></span></div><p class="mt-4 font-mono text-sm text-slate-200">#<%= image.id %> · <%= short_sha(image.original_sha256) %></p><p class="mt-2 text-xs text-slate-500"><%= ui('Expires') %> <%= short_time(image.expires_at) %></p><div class="mt-5 flex gap-3"><%= link_to ui("Details"), submission_path(image), class: "btn-secondary flex-1" %><%= button_to ui("Delete"), submission_path(image), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: ui("Permanently delete this submission, its embeddings and recognition history?") } } %></div></div>
    </article>
  <% end %></div>
<% end %>
