<% content_for :title, "Submission ##{@submission.id} · Rails 8 Face Recognition" %>
<%= link_to "← My submissions", submissions_path, class: "text-link text-sm" %>
<%= render "shared/page_header", eyebrow: ui("Workspace / Private data"), title: "Submission ##{@submission.id}", description: ui("This photo is a temporary query image and is never used for enrollment.") %>
<div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
  <div class="panel overflow-hidden"><% if @submission.image.attached? && @submission.expires_at.future? %><%= image_tag face_image_path(@submission), alt: ui("Private uploaded face image"), class: "max-h-[680px] w-full object-contain" %><% else %><p class="p-10 text-slate-500"><%= ui('Preview no longer available.') %></p><% end %></div>
  <div class="space-y-5"><div class="panel space-y-5 p-6"><div><p class="detail-label"><%= ui('Uploaded') %></p><p class="detail-value"><%= short_time(@submission.created_at) %></p></div><div><p class="detail-label"><%= ui('Expires') %></p><p class="detail-value"><%= short_time(@submission.expires_at) %></p></div><div><p class="detail-label"><%= ui('SHA-256') %></p><p class="detail-value break-all font-mono text-xs"><%= @submission.original_sha256 %></p></div></div>
    <% if @submission.expires_at.future? && @submission.image.attached? %><%= button_to ui("Try recognition"), recognition_attempts_path(face_image_id: @submission.id), method: :post, class: "btn-primary w-full", form: { data: { turbo_confirm: ui("Send this authorized image to your configured inference service?") } } %><% end %>
    <%= button_to ui("Delete image and related data"), submission_path(@submission), method: :delete, class: "btn-danger w-full", form: { data: { turbo_confirm: ui("Delete this private image, all embeddings and all recognition attempts for it?") } } %>
    <div class="panel p-6"><h2 class="font-semibold"><%= ui('Recent attempts') %></h2><% if @attempts.any? %><div class="mt-4 space-y-3"><% @attempts.each do |a| %><div class="flex items-center justify-between gap-3"><%= link_to "Request ##{a.id}", recognition_attempt_path(a), class: "text-link text-sm" %><%= status_badge(a.decision) %></div><% end %></div><% else %><p class="mt-3 text-sm text-slate-500"><%= ui('No attempts for this submission.') %></p><% end %></div>
  </div>
</div>
