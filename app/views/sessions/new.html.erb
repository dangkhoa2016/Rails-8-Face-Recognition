<% content_for :title, "#{t('auth.sign_in')} · Rails 8 Face Recognition" %>
<div class="mx-auto max-w-md panel p-8 sm:p-10">
  <p class="section-kicker"><%= t('auth.member_access') %></p>
  <h1 class="page-title"><%= t('auth.sign_in') %></h1>
  <p class="page-description"><%= t('auth.sign_in_intro') %></p>
  <%= form_with url: session_path, scope: nil, class: 'mt-7 space-y-5' do |form| %>
    <div><%= form.label :email, t('auth.email'), class: 'field-label' %><%= form.email_field :email, required: true, autocomplete: 'username', class: 'field' %></div>
    <div><%= form.label :password, t('auth.password'), class: 'field-label' %><%= form.password_field :password, required: true, autocomplete: 'current-password', class: 'field' %></div>
    <%= form.submit t('auth.sign_in'), class: 'btn-primary w-full' %>
  <% end %>
  <div class="mt-6 flex flex-wrap justify-between gap-3 text-sm">
    <%= link_to t('auth.forgot_password'), new_password_reset_path, class: 'text-link' %>
    <%= link_to t('auth.resend_verification'), new_verification_email_path, class: 'text-link' %>
  </div>
  <% if registration_available? %><%= link_to t('auth.signup_invite'), new_registration_path, class: 'btn-secondary mt-6 w-full' %><% end %>
</div>
